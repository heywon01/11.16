{
  "version": 2,
  "builds": [
    {
      "src": "index.js", 
      "use": "@vercel/node"
    }
  ],
  "files": [
    "index.js",
    "models/**/*",
    "node_modules/**", 
    "index.html",
    "style.css",
    "script.js",
    "public/**/*", 
    "favicon.ico" 
  ],
  "routes": [
    {
      "src": "/(.*)", 
      "dest": "index.js"
    }
  ]
}