{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html", 
      "use": "@vercel/static"
    },
    {
      "src": "public/*", 
      "use": "@vercel/static"
    }
  ],
  "routes": [
    
    {
      "src": "/output.css",
      "dest": "/public/output.css"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|svg))", 
      "dest": "/public/$1"
    },
    {
      "src": "/style.css",
      "dest": "/public/style.css"
    },
    
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}