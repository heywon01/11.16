{
  "name": "math-quiz-backend",
  "version": "1.0.0",
  "description": "Backend for Math Quiz App using Express and MongoDB",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon api/index.js",
    "build": "npx tailwindcss -i ./input.css -o ./public/output.css --minify",
    "build-css": "npx tailwindcss -i ./input.css -o ./public/output.css", 
    "watch-css": "npx tailwindcss -i ./input.css -o ./public/output.css --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "mongoose": "^8.4.1",
    "socket.io-client": "^4.x.x" 
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "nodemon": "^3.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  }
}